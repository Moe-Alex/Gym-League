<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#15101D"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Heading -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚡ ADD YOUR OWN EXERCISE"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp"
            android:text="Create a custom exercise for the Training Arena."
            android:textColor="#AFA8B8"
            android:textSize="13sp" />

        <!-- Exercise Name -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="EXERCISE NAME"
            android:textColor="#B98CFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etCustomExerciseName"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:backgroundTint="#8A2BE2"
            android:hint="e.g. Dumbbell Fly"
            android:inputType="textCapWords"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#77707F" />

        <!-- Muscle Group -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="MUSCLE GROUP"
            android:textColor="#B98CFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Muscle Group Dropdown -->
        <Spinner
            android:id="@+id/spinnerCustomMuscleGroup"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:backgroundTint="#8A2BE2"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <!-- Description -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="DESCRIPTION"
            android:textColor="#B98CFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etCustomDescription"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginTop="6dp"
            android:backgroundTint="#8A2BE2"
            android:gravity="top"
            android:hint="Describe the exercise..."
            android:inputType="textMultiLine"
            android:padding="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#77707F" />

        <!-- Default Sets -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="DEFAULT SETS"
            android:textColor="#B98CFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etCustomSets"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:backgroundTint="#8A2BE2"
            android:hint="e.g. 3"
            android:inputType="number"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#77707F" />

        <!-- Default Reps -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="DEFAULT REPS"
            android:textColor="#B98CFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etCustomReps"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:backgroundTint="#8A2BE2"
            android:hint="e.g. 10"
            android:inputType="number"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#77707F" />

        <!-- Save -->
        <Button
            android:id="@+id/btnSaveCustomExercise"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#8A2BE2"
            android:text="SAVE EXERCISE"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <!-- Cancel -->
        <Button
            android:id="@+id/btnCancelCustomExercise"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#292231"
            android:text="CANCEL"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>