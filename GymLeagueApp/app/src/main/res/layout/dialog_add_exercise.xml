<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#15101D"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Heading -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/i18n_add_your_own_exercise"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp"
            android:text="@string/i18n_create_a_custom_exercise_for_the_training_are"
            android:textColor="#AFA8B8"
            android:textSize="13sp" />

        <!-- Exercise Name -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/i18n_exercise_name"
            android:textColor="#B98CFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etCustomExerciseName"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:backgroundTint="#8A2BE2"
            android:hint="@string/i18n_e_g_dumbbell_fly"
            android:inputType="textCapWords"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#77707F" />

        <!-- Muscle Group -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/i18n_muscle_group"
            android:textColor="#B98CFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Muscle Group Dropdown -->
        <Spinner
            android:id="@+id/spinnerCustomMuscleGroup"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:backgroundTint="#8A2BE2"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <!-- Description -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/i18n_description"
            android:textColor="#B98CFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etCustomDescription"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginTop="6dp"
            android:backgroundTint="#8A2BE2"
            android:gravity="top"
            android:hint="@string/i18n_describe_the_exercise"
            android:inputType="textMultiLine"
            android:padding="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#77707F" />

        <!-- Default Sets -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/i18n_default_sets"
            android:textColor="#B98CFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etCustomSets"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:backgroundTint="#8A2BE2"
            android:hint="@string/i18n_e_g_3"
            android:inputType="number"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#77707F" />

        <!-- Default Reps -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/i18n_default_reps"
            android:textColor="#B98CFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etCustomReps"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:backgroundTint="#8A2BE2"
            android:hint="@string/i18n_e_g_10"
            android:inputType="number"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#77707F" />

        <!-- Save -->
        <Button
            android:id="@+id/btnSaveCustomExercise"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#8A2BE2"
            android:text="@string/i18n_save_exercise"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <!-- Cancel -->
        <Button
            android:id="@+id/btnCancelCustomExercise"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#292231"
            android:text="@string/i18n_cancel"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>