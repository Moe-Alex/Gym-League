<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#15101D"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/i18n_new_challenge"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp"
            android:text="@string/i18n_create_and_conquer_a_challenge"
            android:textColor="#AFA8B8"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvChallengeOpponent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/i18n_challenging_caleb"
            android:textColor="#25D9F5"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/i18n_title"
            android:textColor="#B98CFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etChallengeTitle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:backgroundTint="#8A2BE2"
            android:hint="@string/i18n_e_g_7_day_showdown"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#77707F" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/i18n_description"
            android:textColor="#B98CFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etChallengeDescription"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_marginTop="6dp"
            android:backgroundTint="#8A2BE2"
            android:gravity="top"
            android:hint="@string/i18n_most_workouts_wins"
            android:inputType="textMultiLine"
            android:padding="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#77707F" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/i18n_type"
            android:textColor="#B98CFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerChallengeType"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:backgroundTint="#8A2BE2"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/i18n_target"
            android:textColor="#B98CFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etChallengeTarget"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:backgroundTint="#8A2BE2"
            android:hint="@string/i18n_e_g_5"
            android:inputType="number"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#77707F" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/i18n_xp_reward"
            android:textColor="#B98CFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etChallengeXpReward"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:backgroundTint="#8A2BE2"
            android:hint="@string/i18n_e_g_150"
            android:inputType="number"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#77707F" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/i18n_end_date_yyyy_mm_dd"
            android:textColor="#B98CFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etChallengeEndDate"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:backgroundTint="#8A2BE2"
            android:clickable="true"
            android:cursorVisible="false"
            android:focusable="false"
            android:hint="@string/battle_end_date_hint"
            android:importantForAutofill="no"
            android:inputType="none"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#77707F" />

        <Button
            android:id="@+id/btnLaunchChallenge"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#8A2BE2"
            android:text="@string/i18n_launch_challenge"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCancelChallenge"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#292231"
            android:text="@string/i18n_cancel"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>