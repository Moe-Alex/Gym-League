<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#09060F">

    <ScrollView
        android:id="@+id/squadScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:background="#09060F"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:overScrollMode="always"
        android:scrollbars="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingEnd="20dp"
            android:paddingBottom="30dp">

            <!-- Branding -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ GYMLEAGUE"
                android:textColor="#B45CFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <!-- Main heading -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/i18n_your_squad"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/i18n_train_together_streak_together_win_together"
                android:textColor="#918A9D"
                android:textSize="13sp" />

            <!-- Squad overview -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_exercise_card"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/tvSquadName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/i18n_your_squad"
                    android:textColor="#FFFFFF"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/i18n_shared_streak"
                    android:textColor="#25D9F5"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/tvSharedStreak"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/i18n_shared_streak_0_days"
                    android:textColor="#B45CFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/i18n_keep_training_to_protect_your_squad_streak"
                    android:textColor="#918A9D"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- Members -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/i18n_squad_members"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/i18n_your_training_team"
                android:textColor="#918A9D"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/membersContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tvEmptySquad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_exercise_card"
                android:gravity="center"
                android:padding="22dp"
                android:text="No squad members yet.\nInvite someone to start training together."
                android:textColor="#918A9D"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- Create squad -->
            <TextView
                android:id="@+id/tvCreateSquadHeading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/i18n_create_your_squad"
                android:textColor="#B45CFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:visibility="gone" />

            <EditText
                android:id="@+id/etCreateSquadName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_gym_search"
                android:hint="@string/i18n_enter_a_squad_name"
                android:inputType="textCapWords"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#716B78"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnCreateSquad"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#8A2BE2"
                android:text="@string/i18n_create_squad"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Find and invite members -->
            <TextView
                android:id="@+id/tvInviteHeading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/i18n_find_gymleague_users"
                android:textColor="#25D9F5"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvInviteDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/i18n_search_for_registered_users_to_add_to_your_sq"
                android:textColor="#918A9D"
                android:textSize="12sp"
                android:visibility="gone" />

            <EditText
                android:id="@+id/etInviteUsername"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_gym_search"
                android:hint="@string/i18n_search_username"
                android:inputType="text"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#716B78"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnFindUsers"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#17111F"
                android:text="@string/i18n_find_users"
                android:textColor="#25D9F5"
                android:textStyle="bold"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/userSearchResults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnInviteMember"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#8A2BE2"
                android:text="@string/i18n_invite_to_squad"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Loading -->
            <ProgressBar
                android:id="@+id/progressSquad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="24dp"
                android:indeterminateTint="#B45CFF"
                android:visibility="gone" />

            <!-- Refresh -->
            <Button
                android:id="@+id/btnRefreshSquad"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="26dp"
                android:backgroundTint="#8A2BE2"
                android:text="@string/i18n_refresh_squad"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <!-- Leave squad -->
            <Button
                android:id="@+id/btnLeaveSquad"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#28151D"
                android:text="@string/i18n_leave_squad"
                android:textColor="#FF6B81"
                android:textStyle="bold"
                android:visibility="gone" />

        </LinearLayout>

    </ScrollView>

    <include
        android:id="@+id/bottomNavigation"
        layout="@layout/bottom_nav"
        android:layout_width="0dp"
        android:layout_height="72dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>