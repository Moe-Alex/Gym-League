<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card_personal_record"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvPrBadge"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_badge_circle"
        android:gravity="center"
        android:text="B"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvPrExerciseName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="Bench Press"
        android:textColor="@color/on_surface_dark"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/tvPrOneRepMax"
        app:layout_constraintStart_toEndOf="@id/tvPrBadge"
        app:layout_constraintTop_toTopOf="@id/tvPrBadge" />

    <TextView
        android:id="@+id/tvPrOneRepMax"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Est. 1RM: 96.3 kg"
        android:textColor="@color/gym_gold"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvPrBadge" />

    <TextView
        android:id="@+id/tvPrBestSet"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        android:text="Best set: 82.5 kg x 5 reps"
        android:textColor="@color/on_surface_secondary_dark"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/tvPrBadge"
        app:layout_constraintTop_toBottomOf="@id/tvPrExerciseName" />

    <TextView
        android:id="@+id/tvPrDate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="2dp"
        android:text="Achieved: 2026-09-20"
        android:textColor="@color/on_surface_secondary_dark"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/tvPrBadge"
        app:layout_constraintTop_toBottomOf="@id/tvPrBestSet" />

</androidx.constraintlayout.widget.ConstraintLayout>