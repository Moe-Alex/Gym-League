<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Lets the app know when the phone goes offline or comes back online -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Needed on Android 13+ to show push notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".GymLeagueApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="GymLeague"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GymLeague">
        <activity
            android:name=".ExerciseLibraryActivity"
            android:exported="false"
            android:launchMode="singleTask" />
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTask" />
        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".LoginActivity"
            android:exported="false" />
        <activity
            android:name=".LogExerciseActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".SquadActivity"
            android:exported="false"
            android:launchMode="singleTask" />

        <activity
            android:name=".PersonalRecordsActivity"
            android:exported="false"
            android:launchMode="singleTask" />

        <activity
            android:name=".BattleActivity"
            android:exported="false"
            android:launchMode="singleTask" />

        <activity
            android:name=".MuscleVolumeActivity"
            android:exported="false" />

        <!-- Receives push notifications from Firebase Cloud Messaging -->
        <service
            android:name=".GymLeagueMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- How notifications that Firebase shows by itself (app closed) look -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_gymleague" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/gym_purple" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="challenges" />
    </application>

</manifest>